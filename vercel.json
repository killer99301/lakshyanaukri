{
  "framework": "nextjs",
  "ignoreCommand": "BASE=${VERCEL_GIT_PREVIOUS_SHA:-HEAD~1}; git cat-file -e \"$BASE^{commit}\" 2>/dev/null || exit 1; git diff \"$BASE\" HEAD --name-only | grep -qE '^(src/|scripts/validate\\.ts|next\\.config\\.|package(-lock)?\\.json|vercel\\.json|tsconfig\\.json|postcss\\.config\\.|public/)' && exit 1; exit 0",
  "crons": [
    {
      "path": "/api/cron/attention",
      "schedule": "30 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/og.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}

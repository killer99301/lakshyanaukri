# ═══════════════════════════════════════════════════════════
# LakshyaNaukri — Environment Variables
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env.local (gitignored) and fill in values.
# Never commit .env.local.
# ═══════════════════════════════════════════════════════════

# ─── Database (Neon Postgres) ──────────────────────────────
# Required for all auth operations and admin sessions.
# Get from: https://neon.tech — your project's connection string.
DATABASE_URL=postgresql://user:pass@ep-name-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── OTP signing key ──────────────────────────────────────
# 64 hex characters (32 bytes). Used to sign OTP codes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED. Without it, recovery flow throws on startup.
ADMIN_OTP_HMAC_KEY=

# ─── Resend (email delivery) ──────────────────────────────
# Optional in development: OTPs are logged to console when not set.
# Required in production for password recovery.
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# ─── Email sender address ─────────────────────────────────
# The "From" address for auth emails.
# Must be a verified domain in your Resend account.
ADMIN_EMAIL_FROM=LakshyaNaukri Admin <noreply@lakshyanaukri.in>

# ─── Upstash Redis (rate limiting) ────────────────────────
# Optional in development: in-memory fallback is used (with warning).
# Required in production (without it, all requests are blocked).
# Get from: https://console.upstash.com — create a Redis database.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── App URL (CSRF origin check) ─────────────────────────
# Base URL of the deployed app. Used to validate Origin headers.
# In development: defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=https://lakshyanaukri.in

# ─── Admin allowed origins (optional) ────────────────────
# Comma-separated list of allowed origins for admin API requests.
# Defaults to NEXT_PUBLIC_APP_URL. Only needed for multi-origin setups.
# ADMIN_ALLOWED_ORIGINS=https://lakshyanaukri.in,https://admin.lakshyanaukri.in

# ─── GitHub (PR creation) ─────────────────────────────────
# Used by /api/admin/candidates/[id]/approve to create PRs.
GITHUB_TOKEN=
GITHUB_REPOSITORY=LakshyaNaukri/career-campus
